             <height>19</height>
            </size>
           </property>
           <property name="toolTip">
            <string>Sample extra keys between existing keyframes — for baking curves before export, locking timing down, or thinning an over-keyed curve back out.

Option box: set the frame window and the sampling density (Percent), leave visibility curves alone, or flip to Remove Intermediate Keys to strip a range back to its two end keys.</string>
           </property>
           <property name="text">
            <string>Add Intermediate Keys</string>
           </property>
           <property name="checkable">
            <bool>false</bool>
           </property>
