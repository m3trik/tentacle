            <size>
             <width>16777215</width>
             <height>19</height>
            </size>
           </property>
           <property name="toolTip">
            <string>Reverse the selected keyframes in time — by default, mirrored in place.

Option box: mirror key times (X), values about a pivot (Y), or both; or leave the source alone and place a reversed copy at another start time.</string>
           </property>
           <property name="text">
            <string>Invert Keys</string>
           </property>
           <property name="checkable">
            <bool>false</bool>
           </property>
          </widget>
         </item>
