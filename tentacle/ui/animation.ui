             <width>16777215</width>
             <height>19</height>
            </size>
           </property>
           <property name="toolTip">
            <string>Push keys apart or pull them closer by a fixed frame amount. Every key at or after the given frame shifts by the same offset, so negative amounts compress the timing.

Option box: set the start frame and amount, choose which keys are in scope, and read Amount as an exact target gap instead of a distance.</string>
           </property>
           <property name="text">
            <string>Adjust Spacing</string>
           </property>
           <property name="checkable">
            <bool>false</bool>
           </property>
          </widget>
         </item>
