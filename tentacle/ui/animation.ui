            </size>
           </property>
           <property name="toolTip">
            <string>Re-time the selected objects so their animations play one after another instead of on top of each other.

Option box: set the gap or fixed interval between blocks, group overlapping or touching objects so they move as one, and reverse the order.</string>
           </property>
           <property name="text">
            <string>Stagger Keys</string>
           </property>
           <property name="checkable">
            <bool>false</bool>
           </property>
          </widget>
