        </property>
       </widget>
      </item>
      <item>
       <widget class="PushButton" name="b_undo">
        <property name="toolTip">
         <string>Undo the last change to the mix (Ctrl+Z).</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="PushButton" name="b_redo">
        <property name="toolTip">
         <string>Redo (Ctrl+Shift+Z).</string>
