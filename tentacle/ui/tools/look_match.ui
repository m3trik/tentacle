      </item>
      <item>
       <widget class="PushButton" name="b_fit">
        <property name="text">
         <string>Fit</string>
        </property>
        <property name="toolTip">
         <string>Propose weights for the layers ticked in the Fit column, scored on the selected regions (or all). Nothing changes until you accept the proposal. Options in its option box.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="PushButton" name="b_update">
        <property name="text">
         <string>Update layers</string>
        </property>
        <property name="toolTip">
         <string>Bake again the layers an older save of the scene made: a Maya opens minimized to bake them from the scene as saved, and closes a few minutes after the last.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="PushButton" name="b_render">
        <property name="text">
         <string>Render in WebXR</string>
        </property>
        <property name="toolTip">
         <string>Render this mix in the real WebXR viewer (highlights and specular included) and show it as "WebXR frame". The first render starts the viewer, which takes a few minutes.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="PushButton" name="b_save_rig">
        <property name="text">
         <string>Save to Rig Library</string>
        </property>
        <property name="toolTip">
         <string>Save this mix as a light rig in the rig library every host shares: apply it in Maya's Light Rigs panel to build and bake it.</string>
        </property>
       </widget>
      </item>
