              <horstretch>0</horstretch>
              <verstretch>1</verstretch>
             </sizepolicy>
            </property>
            <property name="toolTip">
             <string>Every lightmap the scene reads: how many objects read it and whether it is up to date. Hover a row for its folder, who wrote it and why it re-bakes; select rows to select their objects. Right-click a row to open its map's folder. The full Bake Report is in the header menu.</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </widget>
      </item>
      <item>
       <spacer name="verticalSpacer">
        <property name="orientation">
         <enum>Qt::Vertical</enum>
        </property>
        <property name="sizeType">
         <enum>QSizePolicy::Fixed</enum>
        </property>
        <property name="sizeHint" stdset="0">
