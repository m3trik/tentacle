        <property name="toolTip">
         <string>Bake — what a new bake covers and how it renders.

Manage — the maps the scene already reads: which are out of date and why, re-baked or reverted from one list.</string>
        </property>
        <property name="frame">
         <bool>false</bool>
        </property>
