       <item>
        <widget class="ComboBox" name="cmb_bake_layer">
         <property name="toolTip">
          <string>Override Layer: bake over the original animation, which stays connected underneath with its drivers — nondestructive.
Base Layer: bake into the base animation, disconnecting the drivers — recoverable via Unbake, unless Delete Inputs is also set.
(Blender bakes into a fresh action and mutes the rig either way; Base Layer only unlocks Delete Inputs.)</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="chk_delete_inputs">
         <property name="toolTip">
          <string>Delete the drivers (constraints, expressions; in Blender, constraints and drivers) after baking.
Base Layer only. Permanently removes them — not reversible by Unbake;
a scene backup is saved automatically.</string>
         </property>
         <property name="text">
          <string>Delete Inputs</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="chk_mute_drivers">
         <property name="toolTip">
          <string>Mute the drivers after baking instead of deleting them (wins over Delete Inputs).
With Override Layer it also spares playback the live rig. (Blender always mutes them.)</string>
         </property>
         <property name="text">
          <string>Mute Drivers</string>
         </property>
        </widget>
